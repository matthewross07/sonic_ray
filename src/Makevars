# ==============================================================================
# sonicray/src/Makevars
# Compiles Objective-C++ against Apple's Metal & Foundation frameworks with the standard macOS Command Line Tools
# (no full Xcode.app, no xcrun metal, and no third-party libraries: the Metal shaders compile at run time).
# ==============================================================================
CXX_STD = CXX17
PKG_CPPFLAGS = -ObjC++ -fobjc-arc
PKG_LIBS = -framework Metal -framework Foundation -framework CoreGraphics
